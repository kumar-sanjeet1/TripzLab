# Set on your Open WebUI server / Railway environment, never in this code file.
# You can leave these unset locally if your existing Admin -> Images Azure key works.
TRIPZ_AZURE_FOUNDRY_API_KEY=
# For a fresh local container / Railway staging service only:
# Generate WEBUI_SECRET_KEY once, keep it stable, and enter these values locally.
WEBUI_SECRET_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
TRIPZ_AUTO_INSTALL=true
# Optional, if FLUX and Sunburst are from different Azure resources:
TRIPZ_FLUX_API_KEY=
TRIPZ_SUNBURST_API_KEY=
# Required endpoints when not configured through the Function admin Valves:
TRIPZ_SUNBURST_ENDPOINT=
TRIPZ_FLUX_ENDPOINT=
# TRIPZ_SUNBURST_DEPLOYMENT=gpt-image-2.5-sunburst
# TRIPZ_FLUX_MODEL=FLUX.2-pro

# Optional native general chat. The exact Azure deployment name is preferred.
TRIPZ_CHAT_AUTO_SETUP=false
# TRIPZ_CHAT_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# TRIPZ_CHAT_DEPLOYMENT=<your-text-model-deployment>
# TRIPZ_CHAT_API_KEY=<optional-separate-resource-key>
# Maintenance only: one explicit live reference-edit test per unique ID.
# TRIPZ_EDIT_SMOKE_TEST_ID=
